{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 5,
      "right": 8,
      "left": 7
    },
    "color": {
      "1": "yellow",
      "2": "yellow"
    },
    "type": "small",
    "source": "alpine"
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " OS     ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " Kernel ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " Pkg    ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "memory",
      "key": " RAM  ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": " Disk ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "wm",
      "key": " WM   ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "terminal",
      "key": " Terminal ",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": " TermFont ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": " Shell    ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "command",
      "key": " OS Age ",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": " Uptime ",
      "keyColor": "blue"
    },
    "break"
  ]
}
