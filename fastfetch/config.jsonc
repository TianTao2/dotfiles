{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 0,
      "right": 4,
      "left": 4
    },
    "color": {
      "1": "yellow",
      "2": "yellow"
    },
    "type": "file", //"small"
    "source": "~/.config/fastfetch/logo.txt" //"alpine"
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": "  ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "  ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "  ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "memory",
      "key": "  ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "wm",
      "key": "  ",
      "keyColor": "green"
    },
    "break",
    {
      "type": "terminal",
      "key": "  ",
      "keyColor": "magenta"
    },
    {
      "type": "terminalfont",
      "key": "  ",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "command",
      "key": " OS Age ",
      "keyColor": "blue",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": " 󱫡 ",
      "keyColor": "blue"
    },
    "break"
  ]
}
